# Copy this file to .env.local and change the value if needed. .env.local is git-ignored.
# Base URL of the CampusSlot API, including /api/v1 (see docs/report/5.8_api-design_Batuhan.md).
VITE_API_URL=http://localhost:3000/api/v1

# true = fake API in the browser (MSW, src/mocks/handlers.ts) while the backend is not ready.
# Only works in `npm run dev`. Set to false to call the real API at VITE_API_URL.
VITE_USE_MOCKS=true
