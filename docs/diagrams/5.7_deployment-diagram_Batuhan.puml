@startuml 5.7_deployment-diagram_Batuhan
' 5.7 UML Deployment diagram - CampusSlot (pilot / demo setup = 5.11 Scenario A)
' Owner: Batuhan (System Architect). Text: docs/report/5.7_component-deployment_Batuhan.md
' Render: java -jar plantuml.jar -Playout=smetana -tpng <this file>
title CampusSlot - UML Deployment Diagram (pilot setup, 5.11 Scenario A)
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60

node "User device\n<<device>>\nphone or computer" as Device {
  node "Web browser\n<<execution environment>>" as Browser {
    artifact "CampusSlot SPA\n(running copy of frontend/dist)" as SpaRun
  }
  node "Camera\n<<device>>" as Camera
}

node "Vercel\n<<static hosting, CDN>>" as Vercel {
  artifact "frontend/dist\nindex.html, JS, CSS" as Dist
}

node "Render web service\n<<server>>" as Render {
  node "Node.js >= 22\n<<execution environment>>" as NodeEnv {
    artifact "campusslot-backend\nExpress API + SystemScheduler\n(scheduler runs every 60 s)" as BackendArt
  }
}

node "Neon\n<<database server>>" as Neon {
  database "PostgreSQL\ncampusslot" as PG
}

node "GitHub\n<<source repository>>" as GitHub {
  artifact "MertTomak/SWE307-Term\n(main branch)" as Repo
}

Browser -right- Camera : camera access\n(secure context only)
Browser -down- Vercel : HTTPS\n(load the SPA)
Browser -down- Render : HTTPS\nREST /api/v1, JSON, Bearer JWT
NodeEnv -down- Neon : PostgreSQL protocol over TLS\n(DATABASE_URL)
GitHub .up.> Vercel : <<deploy>>\nfrontend/
GitHub .up.> Render : <<deploy>>\nbackend/

legend bottom
  Environment on Render: DATABASE_URL, JWT_SECRET, CORS_ORIGIN (Vercel URL), PORT.
  Render free tier spins down after 15 min without traffic; the scheduler pauses with it
  and catches up on the next start (5.8.4.9, 5.11).
  Neon free tier scales to zero after 5 min idle; the first query after that is slower (5.11).
  Vercel and Render build and deploy from the main branch on push.
endlegend
@enduml
