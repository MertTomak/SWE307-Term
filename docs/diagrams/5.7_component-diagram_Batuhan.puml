@startuml 5.7_component-diagram_Batuhan
' 5.7 UML Component diagram - CampusSlot
' Owner: Batuhan (System Architect). Text: docs/report/5.7_component-deployment_Batuhan.md
' Render: java -jar plantuml.jar -Playout=smetana -tpng <this file>
title CampusSlot - UML Component Diagram
skinparam shadowing false
skinparam componentStyle uml2
skinparam nodesep 40
skinparam ranksep 50

component "Web Client (React SPA)" as Web {
  component "Pages" as Pages
  component "AuthModule" as AuthM
  component "QrScanner" as Qr
  component "ApiClient" as ApiC
}

interface "REST API /api/v1\n(JSON, Bearer JWT)" as REST

component "CampusSlot API (Node.js + Express)" as Api {
  component "HttpLayer\n(routes, controllers, middleware)" as Http
  component "SystemScheduler\n(jobs J1-J4, every 60 s)" as Sched
  component "Application services" as Svc {
    component "AuthService" as AuthS
    component "ResourceService" as ResS
    component "ReservationService" as RsvS
    component "CheckInService" as ChkS
    component "ReportService" as RepS
    component "NotificationService" as NotS
  }
  component "Domain\n(rules R1-R4,\nReservationStateMachine,\ntime windows R6-R9)" as Dom
  component "Repositories" as Repo
}

interface "SQL\n(PostgreSQL protocol, TLS)" as SQL
database "PostgreSQL" as DB

' Web client
Pages ..> AuthM : use
Pages ..> Qr : use
Pages ..> ApiC : use
AuthM ..> ApiC : use

' Provided and required interface
ApiC ..> REST : require
REST -- Http

' Inside the API
Http ..> Svc : call
Sched ..> Svc : J1-J4
RsvS ..> NotS
ChkS ..> NotS
Svc ..> Dom : check rules
Svc ..> Repo : read / write

' Database
Repo ..> SQL : require\n(Prisma Client)
SQL -- DB

legend bottom
  Every service uses Repositories. ReservationService and CheckInService
  also use Domain and NotificationService. Domain imports no Express or Prisma (5.8.1).
endlegend
@enduml
