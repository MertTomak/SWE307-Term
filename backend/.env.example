# Copy to .env and fill in. .env is git-ignored.

# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campusslot?schema=public"

# HTTP port of the API
PORT=4000

# JWT signing secret (at least 32 random characters) and token lifetime
JWT_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"
JWT_EXPIRES_IN="8h"

# Allowed browser origin for CORS (the Vite dev server by default)
CORS_ORIGIN="http://localhost:5173"

# Run the System Scheduler (R8, R9, completion) inside the API process: true/false
SCHEDULER_ENABLED=true

# Development only: password given to all seeded users
SEED_PASSWORD="CampusSlot123!"
