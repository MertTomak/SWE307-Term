# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.

# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campusslot?schema=public"

# HTTP port of the API. The frontend expects 3000 (frontend/.env.example, H19).
PORT=3000

# JWT signing secret: at least 32 random characters, different for local, demo and production.
# Create one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-64-hex-characters-from-the-command-above"

# Browser origin(s) allowed by CORS, comma-separated (the Vite dev server by default).
CORS_ORIGIN="http://localhost:5173"

# Run the System Scheduler (J1-J4 every 60 seconds) inside the API process: true or false.
SCHEDULER_ENABLED=true

# Daily opening hours for the occupancy rate in the usage report (API-A8, H08). Default 12 (08:00-20:00).
REPORT_OPENING_HOURS_PER_DAY=12

# Number of proxies in front of the API, so rate limits see the client IP. Render: 1. Local: 0.
TRUST_PROXY=0

# Only for the local PGlite database (npm run db:local): it serves one session, so use 1.
# DB_POOL_MAX=1

# Password given to all seeded users. The default is public on GitHub:
# the demo database must be seeded with a secret value (H27).
SEED_PASSWORD="CampusSlot123!"

# Tests only (npm test): a separate, empty database whose name contains "test".
# Every test file deletes all rows in it. Never point it at the development database.
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/campusslot_test?schema=public"
