# Copy to .env and fill in. .env is git-ignored.

# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campusslot?schema=public"

# Development only: password given to all seeded users
SEED_PASSWORD="CampusSlot123!"

# Tests only (npm test): a separate, empty database whose name contains "test".
# Every test file deletes all rows in it. Never point it at the development database.
